{
  "name": "chuys-tacos",
  "type": "module",
  "version": "0.0.1",
  "description": "Landing page and catering inquiry site for Chuy's Tacos",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro build && wrangler dev",
    "deploy": "astro build && wrangler deploy",
    "cf:types": "wrangler types",
    "lint": "biome check src/",
    "lint:fix": "biome check src/ --write",
    "lint:styles": "stylelint 'src/**/*.{css,astro}'",
    "lint:styles:fix": "stylelint 'src/**/*.{css,astro}' --fix",
    "format": "biome format --write .",
    "typecheck": "astro check"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.2",
    "@astrojs/sitemap": "^3.7.4",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.2",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@biomejs/biome": "^2.6.3",
    "@cloudflare/workers-types": "^5.20261027.1",
    "postcss-html": "^1.8.1",
    "stylelint": "^17.16.0",
    "stylelint-config-astro": "^2.0.0",
    "typescript": "^6.0.3",
    "wrangler": "^4.154.0"
  },
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22.23.4"
  }
}
