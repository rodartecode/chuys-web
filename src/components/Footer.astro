---
import { business } from "@data/business";

const { phone, phoneDisplay, email, social } = business;
const { street, suite, city, state, zip } = business.address;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class:list={["container", { "no-social": social.length === 0 }]}>
    <div class="brand-block">
      <span class="brand-mark" aria-hidden="true">CT</span>
      <p class="brand-name">Chuy's Tacos</p>
      <p class="tagline">Tacos hechos con cariño.</p>
    </div>

    <div class="links">
      <h3>Visit</h3>
      <ul>
        <li>{street}, {suite}</li>
        <li>{city}, {state} {zip}</li>
        <li>
          <a href={`tel:${phone}`}>{phoneDisplay}</a>
        </li>
        <li>
          <a href={`mailto:${email}`}>{email}</a>
        </li>
      </ul>
    </div>

    <div class="links">
      <h3>Explore</h3>
      <ul>
        <li><a href="#menu">Menu</a></li>
        <li><a href="#about">About</a></li>
        <li><a href="#catering">Catering</a></li>
        <li><a href="#contact">Request a Quote</a></li>
      </ul>
    </div>

    {
      social.length > 0 && (
        <div class="links">
          <h3>Follow</h3>
          <ul>
            {social.map((link) => (
              <li>
                <a href={link.href} target="_blank" rel="noopener noreferrer">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </div>

  <div class="legal">
    <p>© {year} Chuy's Tacos. All rights reserved.</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-charcoal);
    color: color-mix(in srgb, var(--color-cream) 85%, transparent);
    padding: 4rem 1.5rem 2rem;
  }

  .container {
    max-width: 72rem;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1fr;
    gap: 2.5rem;
    margin-bottom: 3rem;
  }

  .container.no-social {
    grid-template-columns: 1.4fr 1fr 1fr;
  }

  .brand-mark {
    display: inline-grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 999px;
    background: var(--color-terracotta);
    color: var(--color-cream);
    font-family: var(--font-display);
    font-weight: 700;
    margin-bottom: 0.75rem;
  }

  .brand-name {
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--color-cream);
    margin: 0 0 0.4rem;
  }

  .tagline {
    margin: 0;
    color: color-mix(in srgb, var(--color-cream) 65%, transparent);
    font-style: italic;
  }

  .links h3 {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--color-mustard);
    margin: 0 0 0.75rem;
    font-family: var(--font-body);
    font-weight: 700;
  }

  .links ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    font-size: 0.92rem;
  }

  .links a {
    color: color-mix(in srgb, var(--color-cream) 80%, transparent);
    text-decoration: none;
  }

  .links a:hover {
    color: var(--color-mustard);
  }

  .legal {
    max-width: 72rem;
    margin: 0 auto;
    padding-top: 1.5rem;
    border-top: 1px solid color-mix(in srgb, var(--color-cream) 12%, transparent);
    font-size: 0.85rem;
    color: color-mix(in srgb, var(--color-cream) 55%, transparent);
  }

  .legal p {
    margin: 0;
  }

  @media (max-width: 768px) {
    .container,
    .container.no-social {
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
    }
  }

  @media (max-width: 480px) {
    .container,
    .container.no-social {
      grid-template-columns: 1fr;
    }
  }
</style>
