---
import { business, inquiry } from "@data/business";

const eventTypes = ["Wedding", "Corporate", "Private Party", "Quinceañera", "Fundraiser", "Other"];
---

<section id="contact" class="contact">
  <div class="container">
    <header class="section-head">
      <p class="eyebrow">Get in Touch</p>
      <h2>Request a catering quote.</h2>
      <p class="sub">
        Tell us about your event and we'll get back to you within 1 business day with a tailored
        menu and quote.
      </p>
    </header>

    <form class="inquiry-form" data-testid="inquiry-form" novalidate>
      {/* Honeypot — bots fill this; humans don't see it */}
      <div class="sr-only" aria-hidden="true">
        <label for="company">Leave this field empty</label>
        <input type="text" id="company" name="company" tabindex="-1" autocomplete="off" />
      </div>

      <div class="row">
        <div class="field">
          <label for="name">Name <span class="req">*</span></label>
          <input id="name" name="name" type="text" required autocomplete="name" />
        </div>
        <div class="field">
          <label for="email">Email <span class="req">*</span></label>
          <input id="email" name="email" type="email" required autocomplete="email" />
        </div>
      </div>

      <div class="row">
        <div class="field">
          <label for="phone">Phone</label>
          <input id="phone" name="phone" type="tel" autocomplete="tel" />
        </div>
        <div class="field">
          <label for="eventDate">Event date <span class="req">*</span></label>
          <input id="eventDate" name="eventDate" type="date" required />
        </div>
      </div>

      <div class="row">
        <div class="field">
          <label for="guestCount">Guest count <span class="req">*</span></label>
          <input id="guestCount" name="guestCount" type="number" min="1" max="2000" required />
        </div>
        <div class="field">
          <label for="eventType">Event type</label>
          <select id="eventType" name="eventType">
            {eventTypes.map((t) => <option value={t}>{t}</option>)}
          </select>
        </div>
      </div>

      <div class="field">
        <label for="message">Anything else we should know?</label>
        <textarea id="message" name="message" rows="5" maxlength="5000"
          placeholder="Dietary needs, venue, time of day, anything fun about the event…"
        ></textarea>
      </div>

      {/* Turnstile renders here on first interaction; it adds a cf-turnstile-response input */}
      <div class="cf-turnstile" data-sitekey={inquiry.turnstileSiteKey}></div>

      <button type="submit" class="submit">
        <span class="submit-label">Send Inquiry</span>
        <span class="submit-loading" aria-hidden="true">Sending…</span>
      </button>

      <div class="status" role="status" aria-live="polite">
        <p class="status-success">Thanks! We've got your inquiry and will reply within 1 business day.</p>
        <p class="status-pending">Verifying you're human…</p>
        <p class="status-captcha">
          We couldn't verify you're human. Please complete the check above and try again.
        </p>
        <p class="status-error">
          Something went wrong. Please try again or email us at
          <a href={`mailto:${business.email}`}>{business.email}</a>.
        </p>
      </div>
    </form>
  </div>
</section>

<style>
  .contact {
    padding: 5rem 1.5rem;
    background: var(--color-charcoal);
    color: var(--color-cream);
    /* Native popups (select options, date picker) and input icons render dark-themed. */
    color-scheme: dark;
  }

  .container {
    max-width: 44rem;
    margin: 0 auto;
  }

  .section-head {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.18em;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-mustard);
    margin: 0 0 0.75rem;
  }

  h2 {
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    margin: 0 0 0.75rem;
    color: var(--color-cream);
  }

  .sub {
    color: color-mix(in srgb, var(--color-cream) 75%, transparent);
    line-height: 1.55;
    margin: 0;
  }

  .inquiry-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  label {
    font-size: 0.85rem;
    font-weight: 600;
    color: color-mix(in srgb, var(--color-cream) 85%, transparent);
  }

  .req {
    color: var(--color-mustard);
  }

  input,
  select,
  textarea {
    background: color-mix(in srgb, var(--color-cream) 6%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-cream) 18%, transparent);
    color: var(--color-cream);
    border-radius: 0.6rem;
    padding: 0.7rem 0.85rem;
    font: inherit;
    font-size: 0.95rem;
    transition: border-color 150ms ease, background 150ms ease;
  }

  /* Some browsers ignore color-scheme for the option list; without this it's cream on white. */
  option {
    background-color: var(--color-charcoal);
    color: var(--color-cream);
  }

  input:focus,
  select:focus,
  textarea:focus {
    border-color: var(--color-mustard);
    background: color-mix(in srgb, var(--color-cream) 10%, transparent);
    outline: none;
  }

  input.invalid,
  textarea.invalid,
  select.invalid {
    border-color: #e87a5d;
  }

  textarea {
    resize: vertical;
    min-height: 7rem;
  }

  .submit {
    align-self: flex-start;
    background: var(--color-mustard);
    color: var(--color-charcoal);
    border: none;
    padding: 0.95rem 1.75rem;
    border-radius: 999px;
    font-weight: 700;
    font-size: 1rem;
    cursor: pointer;
    position: relative;
    min-width: 12rem;
    transition: transform 150ms ease, background-color 150ms ease;
  }

  .submit:hover:not(:disabled) {
    transform: translateY(-1px);
    background: color-mix(in srgb, var(--color-mustard) 88%, white);
  }

  .submit:disabled {
    opacity: 0.7;
    cursor: not-allowed;
  }

  .submit-loading {
    display: none;
  }

  .submit.is-loading .submit-label {
    display: none;
  }

  .submit.is-loading .submit-loading {
    display: inline;
  }

  .status p {
    display: none;
    margin: 0;
    padding: 1rem 1.25rem;
    border-radius: 0.6rem;
    font-size: 0.95rem;
  }

  .status.show-success .status-success {
    display: block;
    background: color-mix(in srgb, var(--color-leaf) 35%, transparent);
    color: var(--color-cream);
  }

  .status.show-pending .status-pending {
    display: block;
    background: color-mix(in srgb, var(--color-cream) 10%, transparent);
    color: var(--color-cream);
  }

  .status.show-error .status-error,
  .status.show-captcha .status-captcha {
    display: block;
    background: color-mix(in srgb, #b34a2a 35%, transparent);
    color: var(--color-cream);
  }

  .status-error a {
    color: inherit;
  }

  .cf-turnstile:empty {
    display: none;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 640px) {
    .row {
      grid-template-columns: 1fr;
    }
    .submit {
      width: 100%;
    }
  }
</style>

<script>
  interface Turnstile {
    render: (
      el: HTMLElement,
      opts: {
        sitekey: string;
        theme: "dark";
        callback: () => void;
        "error-callback": () => boolean;
      }
    ) => string;
    reset: (id: string) => void;
  }

  const form = document.querySelector(".inquiry-form") as HTMLFormElement | null;
  if (form) {
    const submit = form.querySelector(".submit") as HTMLButtonElement;
    const status = form.querySelector(".status") as HTMLElement;
    const widget = form.querySelector(".cf-turnstile") as HTMLElement;

    const showStatus = (state?: "success" | "error" | "captcha" | "pending") => {
      status.classList.remove("show-success", "show-error", "show-captcha", "show-pending");
      if (state) status.classList.add(`show-${state}`);
    };

    // Turnstile's script is several hundred KB, so load it on first interaction
    // with the form instead of with the page, and render the widget explicitly.
    const w = window as unknown as { turnstile?: Turnstile; onTurnstileLoad?: () => void };
    let widgetId: string | undefined;
    let loadStarted = false;
    let submitWhenVerified = false;

    // If the challenge can't load or run (blocked script, bad site key), don't leave a
    // pending submit stuck on "Verifying…" — fall back to the email-us message.
    const failPendingSubmit = () => {
      if (!submitWhenVerified) return;
      submitWhenVerified = false;
      showStatus("error");
    };

    const loadTurnstile = () => {
      if (loadStarted) return;
      loadStarted = true;
      w.onTurnstileLoad = () => {
        widgetId = w.turnstile?.render(widget, {
          sitekey: widget.dataset.sitekey ?? "",
          theme: "dark",
          callback: () => {
            if (!submitWhenVerified) return;
            submitWhenVerified = false;
            form.requestSubmit();
          },
          // Returning true tells Turnstile the error was handled (no console throw).
          "error-callback": () => {
            failPendingSubmit();
            return true;
          },
        });
      };
      const script = document.createElement("script");
      script.src =
        "https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit&onload=onTurnstileLoad";
      script.async = true;
      script.onerror = () => {
        loadStarted = false; // allow a retry on the next interaction
        script.remove();
        failPendingSubmit();
      };
      // appendChild, not append: workers-types' global Element.append overload shadows the DOM one.
      document.head.appendChild(script);
    };

    const turnstileToken = () =>
      form.querySelector<HTMLInputElement>('[name="cf-turnstile-response"]')?.value ?? "";

    form.addEventListener("focusin", loadTurnstile);

    // Mirror the server's "no past dates" rule using the visitor's local date.
    const eventDate = form.querySelector("#eventDate") as HTMLInputElement;
    const now = new Date();
    eventDate.min = new Date(now.getTime() - now.getTimezoneOffset() * 60_000)
      .toISOString()
      .slice(0, 10);

    const markValidity = (field: HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement) => {
      if (!field.checkValidity()) {
        field.classList.add("invalid");
        return false;
      }
      field.classList.remove("invalid");
      return true;
    };

    form.querySelectorAll<HTMLInputElement>("input, select, textarea").forEach((field) => {
      field.addEventListener("blur", () => {
        if (field.value) markValidity(field);
      });
    });

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      showStatus();

      const required = form.querySelectorAll<HTMLInputElement>("[required]");
      let ok = true;
      required.forEach((field) => {
        if (!markValidity(field)) ok = false;
      });
      if (!ok) return;

      // No token yet: start (or wait for) the challenge and resubmit from its callback.
      if (!turnstileToken()) {
        submitWhenVerified = true;
        loadTurnstile();
        showStatus("pending");
        return;
      }

      const fd = new FormData(form);
      const payload = Object.fromEntries(fd.entries());

      submit.classList.add("is-loading");
      submit.disabled = true;

      try {
        const res = await fetch("/api/inquiry", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload),
        });
        const json = (await res.json().catch(() => ({}))) as { ok?: boolean; error?: string };
        if (json.error === "captcha") {
          showStatus("captcha");
        } else if (!res.ok || !json.ok) {
          throw new Error("inquiry failed");
        } else {
          showStatus("success");
          form.reset();
        }
      } catch {
        showStatus("error");
      } finally {
        submit.classList.remove("is-loading");
        submit.disabled = false;
        // Tokens are single-use; get a fresh one for any further submission.
        if (widgetId) w.turnstile?.reset(widgetId);
      }
    });
  }
</script>
