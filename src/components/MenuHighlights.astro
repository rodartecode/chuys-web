---
import { Image } from "astro:assets";
import OrderButton from "@components/OrderButton.astro";
import { dishPhotos, fullMenu, menuHighlights } from "@data/menu";
import type { ImageMetadata } from "astro";

// dishPhotos holds file names only (tests load menu.ts in plain Node), so resolve them here.
const photoFiles = import.meta.glob<{ default: ImageMetadata }>("../assets/menu/*.jpg", {
  eager: true,
});
const photos = dishPhotos.map((photo) => {
  const src = photoFiles[`../assets/menu/${photo.file}`]?.default;
  if (!src) throw new Error(`dishPhotos: src/assets/menu/${photo.file} is missing`);
  return { ...photo, src };
});

// Matches .dishes below: auto-fill 15rem columns, 1.25rem gaps, inside 1.5rem section padding,
// with the container capped at 72rem; phones (≤548px) get two columns with a 0.75rem gap.
// Keep the two in step, or phones fetch a size too big.
const DISH_SIZES = [
  "(min-width: 68.75rem) 17rem",
  "(min-width: 51.5rem) calc((100vw - 5.5rem) / 3)",
  "(min-width: 34.25rem) calc((100vw - 4.25rem) / 2)",
  "calc((100vw - 3.75rem) / 2)",
].join(", ");
---

<section id="menu" class="menu">
  <div class="container">
    <header class="section-head">
      <p class="eyebrow">From the Kitchen</p>
      <h2>The full menu</h2>
      <div class="order-top">
        <OrderButton />
      </div>
    </header>

    <div class="full-menu">
      <div class="categories">
        {
          fullMenu.map((category) => (
            <div class="category">
              <h3>{category.title}</h3>
              <ul data-testid={`menu-${category.square.toLowerCase()}`}>
                {category.items.map((item) => (
                  <li>
                    <span class="item-name">{item.name}</span>
                    {item.options && (
                      <span class="item-detail">
                        {/* One line on purpose: a line break here renders as a space before each comma. */}
                        {item.options.map((option, i) => <>{i > 0 && ", "}<span>{option}</span></>)}
                      </span>
                    )}
                    {item.description && <span class="item-detail">{item.description}</span>}
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>

    <ul class="dishes" data-testid="dish-photos">
      {
        photos.map((photo) => (
          <li class="card">
            <figure>
              <Image
                src={photo.src}
                alt={photo.alt}
                widths={[320, 480, 640, 960]}
                sizes={DISH_SIZES}
                loading="lazy"
                decoding="async"
              />
              <figcaption>{photo.caption}</figcaption>
            </figure>
          </li>
        ))
      }
    </ul>

    <div class="meats-head">
      <h3>Pick your meat</h3>
      <p class="sub">
        Any of them goes in a taco, burrito, torta, quesadilla, or bowl. Tortillas sourced locally,
        salsas made from scratch.
      </p>
    </div>

    <ul class="grid">
      {
        menuHighlights.map((item) => (
          <li class="card meat">
            <h4>{item.name}</h4>
            <p>{item.description}</p>
          </li>
        ))
      }
    </ul>

    {/* TODO(owner): link to a downloadable PDF menu when available */}
    <div class="order-bottom">
      <OrderButton />
    </div>
  </div>
</section>

<style>
  .menu {
    padding: 5rem 1.5rem;
  }

  .container {
    max-width: 72rem;
    margin: 0 auto;
  }

  .section-head {
    text-align: center;
    max-width: 38rem;
    margin: 0 auto 3rem;
  }

  .eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.18em;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-terracotta);
    margin: 0 0 0.75rem;
  }

  .section-head h2 {
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    margin: 0 0 0.75rem;
  }

  .meats-head {
    text-align: center;
    max-width: 38rem;
    margin: 3.5rem auto 2rem;
  }

  .meats-head h3 {
    font-size: clamp(1.5rem, 2.5vw, 1.9rem);
    margin: 0 0 0.75rem;
  }

  .sub {
    color: var(--color-muted);
    line-height: 1.55;
    margin: 0;
  }

  .dishes,
  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.25rem;
  }

  .dishes {
    margin-top: 2.5rem;
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
  }

  /* Phones: two smaller photos per row instead of eight full-width ones stacked. */
  @media (max-width: 548px) {
    .dishes {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.75rem;
    }

    .dishes figcaption {
      font-size: 0.95rem;
      padding: 0.6rem 0.75rem 0.7rem;
    }
  }

  .grid {
    grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr));
  }

  .card {
    background: var(--color-cream-card);
    border: 1px solid color-mix(in srgb, var(--color-charcoal) 6%, transparent);
    border-radius: 1rem;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 150ms ease, box-shadow 150ms ease;
  }

  .card:hover {
    transform: translateY(-2px);
    box-shadow: 0 18px 40px -22px rgba(31, 22, 17, 0.35);
  }

  figure {
    margin: 0;
  }

  figure img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  figcaption {
    font-family: var(--font-display);
    letter-spacing: -0.01em;
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--color-charcoal);
    padding: 0.85rem 1.1rem 1rem;
  }

  .meat {
    padding: 1.1rem 1.25rem 1.25rem;
  }

  .meat h4 {
    font-family: var(--font-display);
    letter-spacing: -0.01em;
    font-size: 1.25rem;
    margin: 0 0 0.4rem;
    color: var(--color-charcoal);
  }

  .meat p {
    margin: 0;
    color: var(--color-muted);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .full-menu {
    padding: 2rem 1.5rem;
    background: var(--color-cream-card);
    border: 1px solid color-mix(in srgb, var(--color-charcoal) 6%, transparent);
    border-radius: 1rem;
  }

  /* Multi-column flow balances the uneven category lengths better than a grid. */
  .categories {
    columns: 3 17rem;
    column-gap: 2.5rem;
  }

  .category {
    break-inside: avoid;
    margin-bottom: 1.75rem;
  }

  .category h3 {
    font-family: var(--font-display);
    letter-spacing: normal;
    font-size: 1.2rem;
    color: var(--color-terracotta);
    margin: 0 0 0.6rem;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid color-mix(in srgb, var(--color-terracotta) 25%, transparent);
  }

  .category ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .category li {
    padding: 0.4rem 0;
  }

  .item-name {
    display: block;
    font-weight: 600;
    color: var(--color-charcoal);
  }

  .item-detail {
    display: block;
    margin-top: 0.15rem;
    color: var(--color-muted);
    font-size: 0.9rem;
    line-height: 1.45;
  }

  .order-top {
    margin-top: 1.75rem;
  }

  .order-bottom {
    margin-top: 2.5rem;
  }
</style>
