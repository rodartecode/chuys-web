---
import { business } from "@data/business";
import BaseLayout from "@layouts/BaseLayout.astro";
---

<BaseLayout title={`Page not found — ${business.name}`}>
  <main id="main" class="not-found">
    <span class="brand-mark" aria-hidden="true">CT</span>
    <p class="eyebrow">404</p>
    <h1>This page wandered off.</h1>
    <p class="lede">
      The tacos are still where we left them, though.
    </p>
    <div class="cta-row">
      <a class="cta-primary" href="/">Back to the homepage</a>
      <a class="cta-secondary" href={`tel:${business.phone}`}>{business.phoneDisplay}</a>
    </div>
  </main>
</BaseLayout>

<style>
  .not-found {
    min-height: 100vh;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 0.75rem;
    padding: 3rem 1.5rem;
    text-align: center;
    background: var(--color-cream);
  }

  .brand-mark {
    display: inline-grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 999px;
    background: var(--color-terracotta);
    color: var(--color-cream);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.25rem;
    margin-bottom: 0.5rem;
  }

  .eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.18em;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-terracotta);
    margin: 0;
  }

  h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    margin: 0;
    line-height: 1.15;
  }

  .lede {
    color: var(--color-charcoal-soft);
    margin: 0 0 1rem;
  }

  .cta-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
  }

  .cta-primary,
  .cta-secondary {
    padding: 0.85rem 1.5rem;
    border-radius: 999px;
    font-weight: 700;
    text-decoration: none;
  }

  .cta-primary {
    background: var(--color-terracotta);
    color: var(--color-cream);
  }

  .cta-primary:hover {
    background: var(--color-terracotta-dark);
  }

  .cta-secondary {
    border: 2px solid var(--color-terracotta);
    color: var(--color-terracotta);
  }
</style>
